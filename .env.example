# Local setup template. Copy to .env.local and fill only on your machine.
# Do not prefix secrets with NEXT_PUBLIC_; those values are sent to browsers.

# Optional future database connection. Leave empty for in-memory demo mode.
DATABASE_URL=

# Optional server-side LLM fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Required for professor/admin review mutations.
ADMIN_SECRET=

# Required in production to derive opaque daily usage and cache keys.
USAGE_KEY_SECRET=

# Demo and usage controls.
APP_DEMO_MODE=true
MAX_LLM_CALLS_PER_SESSION=3
MAX_LLM_CALLS_PER_QUESTION_PER_DAY=3
MAX_LLM_CALLS_PER_STUDENT_PER_DAY=5
MAX_DAILY_LLM_CALLS=100
MAX_TUTOR_INPUT_CHARS=800
MAX_LLM_OUTPUT_TOKENS=180
MAX_LLM_TOKENS_PER_SESSION=1200
LLM_CACHE_TTL_SECONDS=86400
