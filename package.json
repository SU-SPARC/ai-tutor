{
  "name": "pf-xj-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:migrate": "node scripts/database-migrate.mjs up",
    "db:migrate:status": "node scripts/database-migrate.mjs status",
    "db:migrate:check": "node scripts/database-migrate.mjs check",
    "db:import:approved": "node scripts/import-approved-content.mjs",
    "db:import:review-candidates": "node scripts/import-review-candidates.mjs",
    "db:repair:review-candidate-provenance": "node scripts/repair-review-candidate-provenance.mjs",
    "db:integrity": "node scripts/database-integrity.mjs",
    "db:integrity:audit:production": "node scripts/database-integrity.mjs audit --target production --json --evidence-dir docs/evidence/database-integrity",
    "db:backup:verify": "node scripts/verify-database-backups.mjs --json --evidence-dir docs/evidence/database-backups",
    "db:backup:export": "node scripts/export-database-backup.mjs",
    "db:backup:daily": "node scripts/backup-daily.mjs --target production --manifest-dir docs/evidence/database-recovery --json",
    "db:backup:status": "node scripts/backup-status.mjs --evidence-dir docs/evidence/backup-custody",
    "db:backup:keys": "node scripts/backup-keys.mjs",
    "db:recovery:accept": "node scripts/accept-recovery-objectives.mjs --evidence-dir docs/evidence/database-recovery",
    "db:custody:apply": "node scripts/apply-production-database-custody.mjs",
    "db:custody:verify": "node scripts/verify-production-database-custody.mjs --json --evidence-dir docs/evidence/database-custody",
    "db:recovery:test": "node scripts/test-database-restore.mjs",
    "db:recovery:test:evidence": "node scripts/test-database-restore.mjs --json --evidence-dir docs/evidence/database-recovery",
    "db:pilot-cleanup:inspect": "node scripts/clean-production-pilot-data.mjs inspect --target production --json --evidence-dir docs/evidence/pilot-data-cleanup",
    "db:pilot-cleanup:plan": "node scripts/clean-production-pilot-data.mjs plan --target production --json --evidence-dir docs/evidence/pilot-data-cleanup",
    "db:pilot-cleanup:rehearse": "node scripts/clean-production-pilot-data.mjs rehearse --json --evidence-dir docs/evidence/pilot-data-cleanup",
    "db:pilot-cleanup:execute": "node scripts/clean-production-pilot-data.mjs execute --target production --json --evidence-dir docs/evidence/pilot-data-cleanup",
    "db:seed": "node scripts/prepare-public-db-seed.mjs",
    "syllabus:sync": "node scripts/synchronize-syllabus-topics.mjs",
    "extract:pdf": "node scripts/extract-private-pdfs.mjs",
    "extract:tex": "node scripts/extract-private-tex.mjs",
    "prepare:patterns": "node scripts/prepare-question-patterns.mjs",
    "prepare:question-chunks": "node scripts/prepare-question-chunks.mjs",
    "prepare:course-outline": "node scripts/prepare-course-outline.mjs",
    "prepare:db-seed": "npm run db:seed",
    "prepare:review-queue": "node scripts/prepare-review-queue.mjs",
    "prepare:following-syllabus-questions": "node scripts/generate-following-syllabus-review-candidates.mjs",
    "prepare:next-syllabus-questions": "node scripts/generate-next-syllabus-review-candidates.mjs",
    "prepare:next-uncovered-syllabus-questions": "node scripts/generate-next-uncovered-syllabus-review-candidates.mjs",
    "prepare:syllabus-questions": "node scripts/generate-syllabus-review-candidates.mjs",
    "promote:approved-questions": "node scripts/promote-approved-questions.mjs",
    "generate:questions": "node scripts/generate-questions.mjs",
    "suggest:patterns": "node scripts/suggest-patterns.mjs",
    "validate:generated": "node scripts/validate-generated-questions.mjs",
    "validate:patterns": "node scripts/validate-demo-question-patterns.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pilot:smoke": "node scripts/pilot-smoke.mjs",
    "pilot:smoke:evidence": "node scripts/pilot-smoke.mjs --evidence-dir docs/evidence/database-custody",
    "test:ai-production": "vitest run tests/ai-production-evaluation.test.ts tests/ai-usage-controls.test.ts tests/llm-tutor.test.ts tests/retrieval.test.ts tests/response-guardrails.test.ts tests/tutor-engine.test.ts tests/tutor-respond-api.test.ts tests/tutor-response-boundary.test.ts",
    "test:migrations": "vitest run tests/database-migration-workflow.test.ts tests/production-schema-migration.test.ts tests/approved-content-import.test.ts tests/database-integrity.test.ts tests/database-integrity-evidence.test.ts tests/app-runtime-role.test.ts tests/database-custody.test.ts tests/pilot-data-cleanup.test.ts",
    "test:recovery": "vitest run tests/database-recovery.test.ts tests/database-recovery-evidence.test.ts tests/database-backup-export.test.ts tests/database-backup-verification.test.ts tests/backup-custody.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
